<!-- AI Keyboard: no plain-text (http) connections at all, only system certificates (no user-added ones) (docs/AI.md).
     The loopback exception of the former ChatGPT sign-in is gone. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
